{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://13.228.42.236:8000/api/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "http://13.228.42.236:8000/media/:path*"
    },
    {
      "source": "/((?!assets/|api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
