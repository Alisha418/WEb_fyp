{
  "buildCommand": "cd neat-now-AdminPanel-Web-noor && npm install && npm run build",
  "outputDirectory": "neat-now-AdminPanel-Web-noor/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "http://13.228.42.236:8000/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "http://13.228.42.236:8000/media/$1"
    },
    {
      "source": "/((?!assets/|api/|media/).*)",
      "destination": "/index.html"
    }
  ]
}
